# ─────────────────────────────────────────────────────────────
# Живая вода • Рупор — Mini App configuration example.
# Copy to `.env` (or `.env.local`) and adjust. Do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend. No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Browser-dev fallback: a raw Telegram `initData` string used to authenticate
# when the app is opened outside Telegram (no WebApp SDK present).
# You can also pass it at runtime via the `?initData=...` query parameter,
# which takes precedence over this variable.
# Leave blank in production — real initData comes from the Telegram client.
VITE_DEV_INIT_DATA=
