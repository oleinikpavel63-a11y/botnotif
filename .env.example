# ─────────────────────────────────────────────────────────────
# Living Water Audio Control — пример конфигурации
# Скопируйте в .env и заполните. НЕ коммитьте реальный .env.
# ─────────────────────────────────────────────────────────────

# --- Приложение ---
APP_ENV=development
APP_MODE=LOCAL_MVP                       # LOCAL_MVP | FULL
APP_TIMEZONE=Europe/Chisinau
LOG_LEVEL=INFO
LOG_JSON=false                           # true для JSON-логов (production)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                       # от @BotFather
TELEGRAM_WEBHOOK_SECRET=                  # только FULL (webhook)
INITIAL_OWNER_TELEGRAM_ID=                # ваш Telegram user id (владелец)
TELEGRAM_USE_WEBHOOK=false                # true в FULL

# --- База данных ---
# LOCAL_MVP (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# FULL (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://lwuser:lwpass@postgres:5432/livingwater
REDIS_URL=                                # опционально (FULL)

# --- Публичные URL (FULL) ---
PUBLIC_BASE_URL=                          # https://camp.example.org
MINI_APP_URL=                             # https://camp.example.org/app
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Безопасность ---
SECRET_KEY=change-me-in-production-please-32chars-min
ACCESS_TOKEN_TTL_SECONDS=3600
INITDATA_MAX_AGE_SECONDS=86400            # срок жизни Telegram initData

# --- Player Agent (клиент) ---
AGENT_SERVER_URL=ws://127.0.0.1:8000/ws/agent
AGENT_API_BASE_URL=http://127.0.0.1:8000
AGENT_DEVICE_ID=main-camp-speakers
AGENT_DEVICE_TOKEN=                        # общий секрет устройства (хешируется на сервере)
AGENT_APP_VERSION=1.0.0
AGENT_STOP_FILE=./data/agent-stop.flag     # аварийный stop-файл
AGENT_STATE_DB=./data/agent-state.json
AGENT_HOTKEY=                              # напр. ctrl+alt+s (опционально)

# --- mpv ---
MPV_EXECUTABLE_PATH=                       # путь к mpv/mpv.exe (пусто = из PATH)
MPV_AUDIO_DEVICE=                          # имя устройства (пусто = по умолчанию ОС)
MPV_IPC_SOCKET=                            # пусто = авто (\\.\pipe\lw-mpv / /tmp/lw-mpv.sock)

# --- Громкость ---
DEFAULT_VOLUME=60
MAX_SAFE_VOLUME=80
ABSOLUTE_MAX_VOLUME=100
VOLUME_STEP=5

# --- Тайминги / надёжность ---
HEARTBEAT_INTERVAL_SECONDS=5
DEVICE_OFFLINE_AFTER_SECONDS=20
COMMAND_TTL_SECONDS=20
SCHEDULE_GRACE_PERIOD_SECONDS=60
CALLBACK_TTL_SECONDS=120                   # срок жизни inline-кнопок подтверждения
RESUME_AFTER_RESTART=false

# --- Загрузка файлов ---
MUSIC_CACHE_PATH=./storage/music
MAX_UPLOAD_SIZE_MB=50

# --- Функции ---
TTS_ENABLED=false
MINI_APP_ENABLED=true
